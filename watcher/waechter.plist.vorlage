<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL__</string>

    <!-- Startet den Komplettlauf: transkribieren + nach Notion -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/verarbeiten.sh</string>
    </array>

    <!-- Ausloeser: Aenderungen in diesem Ordner (neue Audiodatei) -->
    <key>WatchPaths</key>
    <array>
        <string>__WATCH_DIR__</string>
    </array>

    <!-- Nicht oefter als alle 10 Sekunden feuern (Debounce) -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>RunAtLoad</key>
    <false/>

    <!-- Log MUSS ausserhalb des beobachteten Ordners liegen, sonst loest
         jedes Log-Schreiben den Waechter erneut aus (Endlosschleife). -->
    <key>StandardOutPath</key>
    <string>__LOGFILE__</string>
    <key>StandardErrorPath</key>
    <string>__LOGFILE__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
