# Tokens fuer den Workflow. Diese Datei NICHT ins Git committen.
# Empfohlener Ablageort (ausserhalb des Repos): ~/.config/whatsapp-workflow/.env
#
# Pflicht: Notion-Integrationstoken (https://www.notion.so/my-integrations)
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Claude-Analyse (Zusammenfassung, Fragen, Testimonial-Erkennung).
# Ohne diesen Key wird das Transkript ohne Analyse abgelegt.
ANTHROPIC_API_KEY=

# Optional: Slack-Benachrichtigung bei neuer Nachricht (Incoming Webhook).
SLACK_WEBHOOK_URL=
